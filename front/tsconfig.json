{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "typeRoots": ["node_modules", "node_modules/@types"],
    "types": [
      "vitest",
      "vite/client",
      "vite-plugin-pwa/client",
      "unplugin-vue-macros/macros-global"
    ],
    "paths": {
      "#/*": ["src/worker/*"],
      "?/*": ["test/*"],
      "~/*": ["src/*"],
      "@ui/*": ["src/components/ui/*"]
    }
  },
  "include": [
    "**/*.md",
    "src/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "test/**/*.ts",
    "src/docs/vite.config.ts",
    "src/docs/**/*.ts",
    "ui-docs/**/*.ts",
    "eslint.config.mjs",
    "cypress.config.ts"
  ],
  "exclude": ["ui-docs/**/*.md"],
  "vueCompilerOptions": {
    "module": "esnext",
    "vitePressExtensions": [".md"],
    "plugins": []
  }
}
