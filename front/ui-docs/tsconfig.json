{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "#/*": ["src/worker/*"],
      "?/*": ["test/*"],
      "~/*": ["src/*"],
      "@ui/*": ["src/components/ui/*"]
    }
  },
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  },
  "include": [".vitepress/**/*.ts", "**/*.md", "**/*.vue"]
}
